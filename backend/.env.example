# ============================================================
# LifeDrop Backend Environment Configuration Template
# Copy this file to .env and provide your production values
# ============================================================

# Application Port (default: 5000)
PORT=5000

# Environment Mode (production | development)
NODE_ENV=production

# JWT Authentication Secret (generate a secure random 64-char hex string)
JWT_SECRET=your_jwt_secret_here

# MongoDB Atlas Connection String (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname)
MONGODB_URI=your_mongodb_atlas_connection_string_here

# Allowed Frontend CORS Origin (e.g. https://your-app.vercel.app or * for all)
CORS_ORIGIN=https://your-frontend.vercel.app